{
  "name": "pasteworks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PasteWorks - an interactive futuristic cemented paste backfill plant",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run verify:check && npm run verify:scenarios && npm run verify:hard && npm run verify:solve",
    "verify:check": "esbuild tools/check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check.mjs --log-level=error && node node_modules/.cache/check.mjs",
    "verify:scenarios": "esbuild tools/scenarios.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/scen.mjs --log-level=error && node node_modules/.cache/scen.mjs",
    "verify:solve": "esbuild tools/solve.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/solve.mjs --log-level=error && node node_modules/.cache/solve.mjs",
    "typecheck": "tsc --noEmit",
    "verify:hard": "esbuild tools/hardmode.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/hm.mjs --log-level=error && node node_modules/.cache/hm.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
