{
  "name": "pasteworks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PasteWorks - an interactive futuristic cemented paste backfill plant",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run verify:check && npm run verify:scenarios && npm run verify:hard && npm run verify:solve && npm run verify:worlds",
    "verify:check": "esbuild tools/check.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check.mjs --log-level=error && node node_modules/.cache/check.mjs",
    "verify:scenarios": "esbuild tools/scenarios.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/scen.mjs --log-level=error && node node_modules/.cache/scen.mjs",
    "verify:solve": "esbuild tools/solve.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/solve.mjs --log-level=error && node node_modules/.cache/solve.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "verify:hard": "esbuild tools/hardmode.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/hm.mjs --log-level=error && node node_modules/.cache/hm.mjs",
    "verify:worlds": "esbuild tools/worlds.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/worlds.mjs --log-level=error && node node_modules/.cache/worlds.mjs --quick",
    "solve:worlds": "esbuild tools/worlds.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/worlds.mjs --log-level=error && node node_modules/.cache/worlds.mjs",
    "arena:build": "esbuild server/main.ts --bundle --platform=node --format=cjs --target=node18 --outfile=server/dist/arena.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "arena": "npm run arena:build && node server/dist/arena.cjs",
    "bake": "node tools/bake.mjs",
    "verify:arena": "esbuild tools/arenamap.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/arenamap.mjs --log-level=error && node node_modules/.cache/arenamap.mjs && npm run arena:build && node tools/arena.mjs"
  },
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
